rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Mỗi người dùng (đăng nhập bằng Google) có 1 "sổ" riêng tại users/{uid}.
    // Chỉ chính chủ mới đọc/ghi được sổ của mình.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Dữ liệu được chia nhỏ thành nhiều phần (mỗi phần < 1MB)
      match /chunks/{chunkId} {
        allow read, write: if request.auth != null && request.auth.uid == userId
                           && chunkId.matches('^[0-9]{1,2}$');
      }
    }

    // v63: "có mặt" của người dùng, để chủ app (admin) biết ai đang dùng.
    //  - Mỗi người chỉ ghi được dòng của chính mình (email phải đúng tài khoản đang đăng nhập).
    //  - Đọc: chính chủ đọc dòng của mình; ADMIN (leminhdbc.hn@gmail.com) đọc được tất cả.
    match /presence/{uid} {
      allow read: if request.auth != null
                  && (request.auth.uid == uid
                      || (request.auth.token.email == 'leminhdbc.hn@gmail.com'
                          && request.auth.token.email_verified == true));
      allow create, update: if request.auth != null && request.auth.uid == uid
                  && request.resource.data.keys().hasOnly(['email','name','photo','firstSeen','lastSeen','device','standalone','version'])
                  && request.resource.data.email == request.auth.token.email;
      allow delete: if false;
    }

    // v96: Hộp thư tự động (Phím tắt iPhone / MacroDroid gửi tin ngân hàng vào, app lấy về rồi xoá).
    //  - inboxOwners/{mã}: chủ sổ (đã đăng nhập) đăng ký mã bí mật ngẫu nhiên của mình.
    //  - inbox/{mã}/items: ai biết mã (Phím tắt, không đăng nhập) chỉ được GHI tin mới;
    //    chỉ chủ sổ mới đọc và xoá được. Mã chưa đăng ký thì không ghi được.
    match /inboxOwners/{secret} {
      allow create: if request.auth != null
                    && secret.matches('^[a-z0-9]{24,64}$')
                    && request.resource.data.keys().hasOnly(['uid','at'])
                    && request.resource.data.uid == request.auth.uid;
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
    match /inbox/{secret}/items/{itemId} {
      allow create: if secret.matches('^[a-z0-9]{24,64}$')
                    && exists(/databases/$(database)/documents/inboxOwners/$(secret))
                    && request.resource.data.keys().hasOnly(['t','s'])
                    && request.resource.data.t is string
                    && request.resource.data.t.size() > 0 && request.resource.data.t.size() <= 2000
                    && (!('s' in request.resource.data) || (request.resource.data.s is string && request.resource.data.s.size() <= 16));
      allow read, delete: if request.auth != null
                    && get(/databases/$(database)/documents/inboxOwners/$(secret)).data.uid == request.auth.uid;
      allow update: if false;
    }

    // Mọi thứ khác: cấm
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
