rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Mỗi người dùng (đăng nhập bằng Google) có 1 "sổ" riêng tại users/{uid}.
    // Chỉ chính chủ mới đọc/ghi được sổ của mình.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Dữ liệu được chia nhỏ thành nhiều phần (mỗi phần < 1MB)
      match /chunks/{chunkId} {
        allow read, write: if request.auth != null && request.auth.uid == userId
                           && chunkId.matches('^[0-9]{1,2}$');
      }
    }

    // v63: "có mặt" của người dùng, để chủ app (admin) biết ai đang dùng.
    //  - Mỗi người chỉ ghi được dòng của chính mình (email phải đúng tài khoản đang đăng nhập).
    //  - Đọc: chính chủ đọc dòng của mình; ADMIN (leminhdbchn@gmail.com) đọc được tất cả.
    match /presence/{uid} {
      allow read: if request.auth != null
                  && (request.auth.uid == uid
                      || (request.auth.token.email == 'leminhdbchn@gmail.com'
                          && request.auth.token.email_verified == true));
      allow create, update: if request.auth != null && request.auth.uid == uid
                  && request.resource.data.keys().hasOnly(['email','name','photo','firstSeen','lastSeen','device','standalone','version'])
                  && request.resource.data.email == request.auth.token.email;
      allow delete: if false;
    }

    // Mọi thứ khác: cấm
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
